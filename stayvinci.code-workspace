{
  // Open this file in VS Code (File > Open Workspace from File...) to see the
  // project as named sections instead of one long folder tree.
  "folders": [
    { "name": "📘 Start here · project root, spec and docs", "path": "." },
    { "name": "💼 Business app · what Houses use (apps/business-web)", "path": "apps/business-web" },
    { "name": "🛍️ Guest app · what clients see (apps/guest-web)", "path": "apps/guest-web" },
    { "name": "🛡️ Admin console · Stayvinci staff (apps/admin-console)", "path": "apps/admin-console" },
    { "name": "⚙️ API server · backend (apps/api)", "path": "apps/api" },
    { "name": "📱 Mobile app · later (apps/guest-mobile)", "path": "apps/guest-mobile" },
    { "name": "🎨 Design system · colours, buttons, logo (packages/ui)", "path": "packages/ui" },
    { "name": "🧪 Demo data · sample Houses and bookings (packages/demo-data)", "path": "packages/demo-data" },
    { "name": "🗄️ Database · schema and migrations (packages/db)", "path": "packages/db" },
    { "name": "🧩 Shared types (packages/types)", "path": "packages/types" },
    { "name": "🔌 API client for the apps (packages/sdk)", "path": "packages/sdk" },
    { "name": "🔧 Tooling presets (packages/config)", "path": "packages/config" },
    { "name": "✨ Brand · logos and documents", "path": "brand" }
  ],
  "settings": {
    // In the root section, hide the folders that already have their own section above.
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.turbo": true,
      "stayvinci-handoff": true,
      "apps": true,
      "packages": true,
      "brand": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, turbo.json, .nvmrc, .npmrc, tsconfig*.json, eslint.config.js, prettier.config.js, .prettierignore, commitlint.config.js, .editorconfig, .gitattributes, .gitignore, vite.config.ts, tailwind-js-scanner.ts, index.html",
      "CLAUDE.md": "AGENTS.md"
    },
    "explorer.compactFolders": false,
    "explorer.sortOrder": "foldersNestsFiles"
  }
}
