{
  "name": "@stayvinci/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend API: NestJS modular monolith with OpenAPI docs at /docs.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "pnpm --filter @stayvinci/types --filter @stayvinci/db build && tsc -p tsconfig.json && node --env-file-if-exists=.env dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@stayvinci/db": "workspace:*",
    "@stayvinci/types": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hash-wasm": "4.13.0",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2"
  }
}
