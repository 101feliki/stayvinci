# Stayvinci API configuration. Copy to apps/api/.env (git-ignored) and fill in.
# The API refuses to start in production if a required secret is missing or weak.

NODE_ENV=development
PORT=4000
# Public URL of this API (used in emailed links that point back to the apps).
PUBLIC_API_URL=http://localhost:4000

# Database. Options:
#   postgres://stayvinci:stayvinci-local-only@127.0.0.1:5432/stayvinci   (Docker Compose)
#   pglite://./.data/pglite                                               (no Docker; file-backed)
DATABASE_URL=pglite://./.data/pglite

# Browser apps allowed to call the API (comma-separated, exact origins).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# Where emailed links land.
GUEST_APP_URL=http://localhost:5174
BUSINESS_APP_URL=http://localhost:5173
CONSOLE_URL=http://localhost:5175

# Secrets: generate each with  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
OTP_PEPPER=
# 32 bytes, base64. Encrypts TOTP seeds. In production, payment credentials use KMS instead.
DATA_ENCRYPTION_KEY=

# Access tokens are short-lived; refresh tokens rotate on every use.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# API docs (Swagger) at /docs. Off in production unless you set both credentials below,
# which then protect the page with HTTP basic auth.
DOCS_ENABLED=true
DOCS_USER=
DOCS_PASSWORD=

# Email (Nodemailer over SMTP): activation, magic-link sign-in, password reset.
# Local: Mailpit from Docker Compose (inbox at http://localhost:8025). Production: any SMTP
# provider, e.g. Resend (smtp.resend.com:465, user "resend", password = API key).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Stayvinci <no-reply@stayvinci.com>"

# SMS sign-in is on hold; people sign in by email. "off" (default) answers 503 on the SMS endpoints.
# "console" prints codes to the API log (development only); "africastalking" later.
SMS_PROVIDER=off

# Email transport. "console" prints emails and their links to the API log (development
# only, handy without Docker/Mailpit). "smtp" uses the SMTP_* settings.
MAIL_TRANSPORT=smtp
